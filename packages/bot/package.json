{
	"name": "@nike-release-checker/bot",
	"version": "0.1.0",
	"description": "Nike SNKRS auto-checkout bot",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"bin": {
		"nike-bot": "./src/cli/index.ts"
	},
	"scripts": {
		"dev": "node --import tsx --watch src/cli/index.ts",
		"start": "node --import tsx src/cli/index.ts",
		"build": "node scripts/bundle.mjs",
		"lint": "npm run typecheck",
		"test": "node --import tsx --test 'src/auth/**/*.test.{ts,tsx}' 'src/checkout/**/*.test.{ts,tsx}' 'src/cli/**/*.test.{ts,tsx}' 'src/config/**/*.test.{ts,tsx}' 'src/country/**/*.test.{ts,tsx}' 'src/logger/**/*.test.{ts,tsx}' 'src/monitor/**/*.test.{ts,tsx}' 'src/stealth/**/*.test.{ts,tsx}' 'src/tui/**/*.test.{ts,tsx}'",
		"test:integration": "node --import tsx --test 'src/__tests__/**/*.test.{ts,tsx}'",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nike-release-checker/sdk": "*",
		"@types/better-sqlite3": "7.6.13",
		"@types/papaparse": "5.5.2",
		"better-sqlite3": "12.11.1",
		"commander": "13.1.0",
		"ink": "6.7.0",
		"ink-spinner": "5.0.0",
		"ink-text-input": "6.0.0",
		"papaparse": "5.5.3",
		"patchright": "1.59.4",
		"playwright": "^1.52.0",
		"react": "^19.2.0",
		"valibot": "1.3.0",
		"yaml": "2.7.1"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "19.2.14",
		"esbuild": "0.27.0",
		"ink-testing-library": "4.0.0",
		"postject": "1.0.0-alpha.6",
		"tsx": "^4.0.0",
		"typescript": "^5.9.3"
	}
}
